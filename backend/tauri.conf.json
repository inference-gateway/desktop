{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Inference Gateway Desktop",
  "version": "0.1.0",
  "identifier": "com.inference-gateway.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": { "script": "bun run build", "wait": true },
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inference Gateway Desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "Computer Use Overlay",
        "width": 200,
        "height": 200,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "contentProtected": true,
        "dragDropEnabled": false
      },
      {
        "label": "monitor",
        "title": "Computer Use",
        "width": 620,
        "height": 102,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "contentProtected": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: https: http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/.infer/tmp/**",
          "$HOME/.infer/tmp/**",
          "$HOME/.infer/projects/*/tmp/**",
          "$HOME/**/.infer/artifacts/**",
          "$HOME/.infer/artifacts/**",
          "$HOME/.infer/projects/*/artifacts/**",
          "$HOME/.infer/voice/samples/**",
          "$HOME/.infer/avatars/**",
          "$HOME/Documents/Inference Gateway Desktop/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/inference-gateway/desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
