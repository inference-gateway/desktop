{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Inference Gateway Desktop",
  "version": "0.1.0",
  "identifier": "com.inference-gateway.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": "bun run build",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inference Gateway Desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "Computer Use Overlay",
        "width": 200,
        "height": 200,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "contentProtected": true,
        "dragDropEnabled": false
      },
      {
        "label": "monitor",
        "title": "Computer Use",
        "width": 620,
        "height": 102,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "contentProtected": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/.infer/tmp/**",
          "$HOME/.infer/tmp/**",
          "$HOME/**/.infer/artifacts/**",
          "$HOME/.infer/artifacts/**",
          "$HOME/.infer/tts/**",
          "$HOME/.infer/models/tts/samples/**"
        ]
      }
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/inference-gateway/desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
