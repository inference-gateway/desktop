#!/bin/sh
# Pre-commit hook: run typecheck and tests before each commit.
# Activate with: git config core.hooksPath .githooks
#
# This hook is inert until the above git config is run.

set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "==> Running pre-commit checks..."

fail=0
for f in $(git ls-files | grep -vE '\.(png|icns|ico)$'); do
    [ -f "$f" ] || continue
    if [ -n "$(tail -c 1 "$f")" ]; then
        echo "missing final newline: $f"
        fail=1
    fi
done
[ "$fail" -eq 0 ] || exit 1

# The Rust build embeds frontendDist (../dist), so build the frontend first.
if command -v bun >/dev/null 2>&1; then
    echo "--> Frontend (bun run build)..."
    (cd "$ROOT" && bun install --frozen-lockfile >/dev/null 2>&1 && bun run build >/dev/null)
fi

cd "$ROOT/backend"

# Run typecheck if cargo is available
if command -v cargo >/dev/null 2>&1; then
    echo "--> Formatting (cargo fmt --check)..."
    cargo fmt --check
    echo "--> Lint (cargo clippy)..."
    cargo clippy -- -D warnings
    echo "--> Typecheck (cargo check)..."
    cargo check
fi

# Run tests if cargo is available
if command -v cargo >/dev/null 2>&1; then
    echo "--> Tests (cargo test)..."
    cargo test
fi

echo "==> All checks passed."
