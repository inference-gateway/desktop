#!/bin/sh

set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "==> Running pre-commit checks..."

if command -v bunx >/dev/null 2>&1; then
    fe=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
    if [ -n "$fe" ]; then
        echo "--> Formatting staged frontend files (prettier --write)..."
        printf '%s\n' "$fe" | xargs bunx prettier --write
        printf '%s\n' "$fe" | xargs git add
    fi
fi

fail=0
for f in $(git ls-files | grep -vE '\.(png|icns|ico)$'); do
    [ -f "$f" ] || continue
    if [ -n "$(tail -c 1 "$f")" ]; then
        echo "missing final newline: $f"
        fail=1
    fi
done
[ "$fail" -eq 0 ] || exit 1

if command -v bun >/dev/null 2>&1; then
    echo "--> Frontend (bun run build)..."
    (cd "$ROOT" && bun install --frozen-lockfile >/dev/null 2>&1 && bun run build >/dev/null)
fi

cd "$ROOT/backend"

if command -v cargo >/dev/null 2>&1; then
    echo "--> Formatting (cargo fmt --check)..."
    cargo fmt --check
    echo "--> Lint (cargo clippy)..."
    cargo clippy -- -D warnings
    echo "--> Typecheck (cargo check)..."
    cargo check
fi

if command -v cargo >/dev/null 2>&1; then
    echo "--> Tests (cargo test)..."
    cargo test
fi

echo "==> All checks passed."

